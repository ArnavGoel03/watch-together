root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[*.{swift,kt,kts,gradle}]
indent_size = 4

[*.{py,gradle.kts}]
indent_size = 4

[*.{xml,plist,strings}]
indent_size = 2
